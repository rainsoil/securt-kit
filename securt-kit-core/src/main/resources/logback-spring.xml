<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- securt-kit 核心模块日志配置 -->
    <logger name="com.chu7.securtkit" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 拦截器日志配置 - 减少详细日志 -->
    <logger name="com.chu7.securtkit.interceptor" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 缓存日志配置 -->
    <logger name="com.chu7.securtkit.cache" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 服务层日志配置 -->
    <logger name="com.chu7.securtkit.service" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 根日志配置 -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 开发环境配置 -->
    <springProfile name="dev">
        <logger name="com.chu7.securtkit" level="DEBUG"/>
    </springProfile>

    <!-- 生产环境配置 -->
    <springProfile name="prod">
        <logger name="com.chu7.securtkit" level="WARN"/>
    </springProfile>
</configuration>
