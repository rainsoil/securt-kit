<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/securt-kit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/securt-kit.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- securt-kit 核心模块日志配置 -->
    <logger name="com.chu7.securtkit" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- 拦截器日志配置 - 减少详细日志 -->
    <logger name="com.chu7.securtkit.interceptor" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- 缓存日志配置 -->
    <logger name="com.chu7.securtkit.cache" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- 服务层日志配置 -->
    <logger name="com.chu7.securtkit.service" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- 测试类日志配置 - 减少详细日志 -->
    <logger name="com.chu7.securtkit.test" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- MyBatis 日志配置 -->
    <logger name="org.apache.ibatis" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <logger name="com.baomidou.mybatisplus" level="WARN"/>

    <!-- Spring 框架日志配置 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.boot" level="INFO"/>

    <!-- 数据库连接池日志配置 -->
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 开发环境配置 -->
    <springProfile name="dev">
        <logger name="com.chu7.securtkit" level="DEBUG"/>
        <logger name="com.chu7.securtkit.interceptor" level="DEBUG"/>
    </springProfile>

    <!-- 生产环境配置 -->
    <springProfile name="prod">
        <logger name="com.chu7.securtkit" level="WARN"/>
        <logger name="com.chu7.securtkit.interceptor" level="ERROR"/>
        <logger name="com.chu7.securtkit.test" level="ERROR"/>
    </springProfile>

    <!-- 测试环境配置 -->
    <springProfile name="test">
        <logger name="com.chu7.securtkit" level="INFO"/>
        <logger name="com.chu7.securtkit.interceptor" level="WARN"/>
        <logger name="com.chu7.securtkit.test" level="INFO"/>
    </springProfile>
</configuration>
